{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "paths": {
      "@/*": ["./src/*"],
      // vscode-textmate ships types but doesn't point at them from its
      // package.json, so resolution has to be told where they are. Types only:
      // Vite and Vitest resolve the runtime module normally.
      "vscode-textmate": ["./node_modules/vscode-textmate/types/vscode-textmate.d.ts"],
      // Same story: `emmet` publishes declarations but its `exports` map has no
      // `types` condition, so bundler resolution can't see them.
      "emmet": ["./node_modules/emmet/dist/index.d.ts"]
    },
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
